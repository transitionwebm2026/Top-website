# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy alternative to the publishable key (used only if the one above is empty):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Public address of the deployed site, used for absolute link-preview (Open Graph) image URLs.
# The dashboard's "Public site URL" setting takes precedence. Read at build time.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
